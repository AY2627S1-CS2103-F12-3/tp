<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<HBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <VBox spacing="4" minHeight="85">
    <padding><Insets top="8" right="8" bottom="8" left="15" /></padding>
    <HBox><Label fx:id="id" styleClass="cell_big_label"/><Label fx:id="title" styleClass="cell_big_label"/></HBox>
    <Label fx:id="experienceLevel" styleClass="cell_small_label"/>
    <Label fx:id="status" styleClass="cell_small_label"/>
  </VBox>
</HBox>
