<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<HBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" minWidth="0">
  <VBox spacing="4" minHeight="85" minWidth="0" HBox.hgrow="ALWAYS">
    <padding><Insets top="8" right="8" bottom="8" left="15" /></padding>
    <HBox>
      <Label fx:id="id" styleClass="cell_big_label" minWidth="-Infinity"/>
      <Label fx:id="title" styleClass="cell_big_label" wrapText="true" minWidth="0" HBox.hgrow="ALWAYS"/>
    </HBox>
    <Label fx:id="experienceLevel" styleClass="cell_small_label" wrapText="true" minWidth="0"/>
    <Label fx:id="status" styleClass="cell_small_label"/>
    <FlowPane hgap="12" vgap="4" prefWrapLength="300">
      <Label fx:id="pendingCount" styleClass="cell_small_label"/>
      <Label fx:id="hiredCount" styleClass="cell_small_label"/>
      <Label fx:id="rejectedCount" styleClass="cell_small_label"/>
      <Label fx:id="withdrawnCount" styleClass="cell_small_label"/>
    </FlowPane>
  </VBox>
</HBox>
